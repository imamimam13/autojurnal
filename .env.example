# OpenAlex (optional — provides higher API rate limits)
OPENALEX_API_KEY=

# Ollama Local (Offline / Localhost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_API_KEY=

# Ollama Cloud / Remote VPS (Optional)
OLLAMA_CLOUD_BASE_URL=https://your-ollama-server.com
OLLAMA_CLOUD_MODEL=gemma3:12b
OLLAMA_CLOUD_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI Compatible (e.g. llama.cpp, LM Studio, vLLM)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=llama3
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1
